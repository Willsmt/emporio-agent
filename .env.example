# LLM provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini
# Optional: override the default model of the provider
LLM_MODEL=
# API key of the chosen provider (Google AI Studio or OpenAI)
LLM_API_KEY=
# Optional: simulate the store's current date (YYYY-MM-DD), e.g. 2026-02-20 to demo open return windows
STORE_TODAY=
